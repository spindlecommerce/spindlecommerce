# Copy to .env for local development. Never use these values in production.

# Unset or memory: → in-memory PGlite; pglite:<dir> → persistent PGlite; postgres://… → PostgreSQL
DATABASE_URL=pglite:./.data/dev
PORT=4000
# Required in production; any long random string locally. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me
DEFAULT_CHANNEL=us
LOG_LEVEL=info

# Development seed (pnpm db:seed). The seed refuses to run with NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=dev-admin-password-123
SEED_CUSTOMER_EMAIL=alex@example.com
SEED_CUSTOMER_PASSWORD=dev-customer-password-123

# ---------------------------------------------------------------------------------------------
# Deployment. Nothing below is needed locally. On Vercel the Marketplace integrations set the
# starred variables (*); see docs/deploy-vercel.md.

# PostgreSQL: DATABASE_URL (*Neon), else POSTGRES_URL (*Supabase, *Neon). Builds migrate over
# DATABASE_URL_UNPOOLED (*Neon) or POSTGRES_URL_NON_POOLING (*Supabase) when set.
# DATABASE_URL_UNPOOLED=
# Connections per process: 10, or 5 on Vercel.
# DATABASE_POOL_SIZE=10

# pnpm vercel:build migrates the database when a PostgreSQL URL is set, except on preview
# builds (which may share the production database); true or false overrides that.
# MIGRATE_ON_BUILD=
# pnpm vercel:build creates this staff user (Administrator role) when the database has none.
# The password needs 12+ characters; remove the variables after the first deployment.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Administrator

# Redis: REDIS_URL, else KV_URL (*Upstash): a redis:// or rediss:// URL, not the REST API.
# Carries GraphQL subscriptions and cache invalidation between processes and serverless
# instances, and holds the shared response cache.
# REDIS_URL=
# Storefront response cache: auto (Redis when set; off on Vercel without Redis; else in memory),
# memory, redis or off.
# GRAPHQL_RESPONSE_CACHE=auto

# GET/POST /internal/worker runs one worker tick (scheduled publishing, outbox, webhooks) when
# called with "Authorization: Bearer <CRON_SECRET>", as Vercel Cron does. In production the
# route is refused without it. Generate one with: openssl rand -base64 48
# CRON_SECRET=
# pnpm vercel:build: the worker cron. Daily by default, which every plan allows; on Vercel Pro or
# Enterprise, "* * * * *" runs it every minute. "off" adds no cron.
# WORKER_CRON_SCHEDULE="0 5 * * *"

# Public admin URL (password reset links, visual editing origin). Default: http://localhost:PORT
# locally; on Vercel, the production domain (previews: their branch URL) plus /admin.
# ADMIN_URL=https://shop-api.example.com/admin
# Comma-separated origins allowed to call the APIs from browsers (storefront default: any).
# STOREFRONT_CORS_ORIGINS=https://shop.example.com
# ADMIN_CORS_ORIGINS=
# Reverse proxies in front of the API that append to X-Forwarded-For (a load balancer, nginx).
# Audit entries record the address the outermost one saw; 0 records the connection's address.
# Vercel sets the header itself, so the default there is 1.
# TRUST_PROXY=0

# Media storage (docs/media.md). Browsers upload straight to the store, not through the API.
# MEDIA_STORAGE: local, vercel-blob or s3. Unset: vercel-blob when BLOB_READ_WRITE_TOKEN is set,
# else s3 when S3_BUCKET is set, else local. Vercel deployments refuse local uploads (no disk).
# MEDIA_STORAGE=
# Vercel Blob: set (*) when a Blob store is connected to the project (Storage > Blob).
# BLOB_READ_WRITE_TOKEN=
# Object keys start with this prefix (Vercel Blob and S3).
# MEDIA_PATH_PREFIX=media
# S3-compatible storage (AWS S3, Cloudflare R2, Supabase Storage, MinIO). The bucket needs a CORS
# rule allowing PUT with a Content-Type header from the admin's origin.
# S3_BUCKET=
# auto (the default) means us-east-1 on AWS; R2 takes auto.
# S3_REGION=auto
# The S3 API URL of providers other than AWS.
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Where objects are served from: a CDN or a public bucket URL.
# S3_PUBLIC_URL=
# Path style (<endpoint>/<bucket>/<key>) is the default with S3_ENDPOINT (MinIO and Supabase need
# it, R2 accepts it); AWS defaults to virtual-hosted style.
# S3_FORCE_PATH_STYLE=
# Local disk (development, Docker, single servers).
# MEDIA_DIR=.data/media
# The URL browsers reach the API's /media at; default: ADMIN_URL without /admin.
# MEDIA_PUBLIC_URL=
# Largest upload in bytes, for every provider (default 20 MB).
# MEDIA_MAX_BYTES=20971520

# Plugins (ecom.config.ts, docs/plugins.md). Their settings can also be entered in the admin
# under Settings › Plugins; a variable set here wins and shows there as read-only.
# Stripe (plugins/stripe): API keys (test mode first), and the signing secret of the webhook
# endpoint https://<api domain>/payments/webhooks/stripe.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# Shippo (@spindlecommerce/plugin-shippo): live carrier rates at checkout and labels when staff ship.
# SHIPPO_API_TOKEN=
# Email (plugins/email): the default "log" transport records emails without sending them. Pick
# Resend (*Vercel Marketplace) or Postmark under Settings › Plugins › Email and set its key.
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=

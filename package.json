{
  "name": "ecom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless commerce platform in TypeScript, on PostgreSQL with a GraphQL-first API.",
  "license": "MIT",
  "engines": {
    "node": ">=24.12"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "worker": "node --env-file-if-exists=.env src/worker.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p admin",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "db:seed:orders": "node --env-file-if-exists=.env src/db/seed-orders.ts",
    "schema:print": "node scripts/print-schema.ts && node scripts/admin-graphql-env.ts",
    "sdk:package": "node scripts/plugin-sdk-package.ts",
    "e2e": "node --env-file-if-exists=.env scripts/e2e-flow.ts",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:vite": "vite --config admin/vite.config.ts",
    "vercel:build": "pnpm admin:build && node scripts/vercel-build.ts",
    "vercel:smoke": "node scripts/vercel-build.ts --smoke"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@graphql-yoga/plugin-persisted-operations": "4.0.1",
    "@graphql-yoga/plugin-response-cache": "4.0.1",
    "@hono/node-server": "2.1.5",
    "@node-rs/argon2": "2.2.2",
    "@pothos/core": "4.16.0",
    "@pothos/plugin-complexity": "4.2.3",
    "@pothos/plugin-errors": "4.9.3",
    "@pothos/plugin-relay": "4.8.1",
    "@pothos/plugin-scope-auth": "4.2.2",
    "@pothos/plugin-simple-objects": "4.1.4",
    "@pothos/plugin-sub-graph": "4.5.3",
    "@pothos/plugin-tracing": "1.1.4",
    "@spindlecommerce/plugin-sdk": "workspace:*",
    "@spindlecommerce/plugin-shippo": "1.0.1",
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "3.9.11",
    "aws4fetch": "1.0.20",
    "dataloader": "2.2.3",
    "drizzle-orm": "0.45.4",
    "graphql": "17.0.2",
    "graphql-yoga": "6.0.1",
    "hono": "4.13.13",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@gql.tada/internal": "1.2.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "gql.tada": "1.11.4",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "uqr": "0.1.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
